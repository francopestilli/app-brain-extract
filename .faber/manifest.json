{
  "name": "app-brain-extract",
  "github": "gamorosino/app-brain-extract",
  "github_branch": "main",
  "desc": "Skull-strip a T1w volume using FSL BET",
  "config": {
    "t1": {
      "type": "input",
      "file_id": "t1",
      "input_id": "t1"
    },
    "frac": {
      "id": "frac",
      "type": "number",
      "placeholder": "0.5",
      "advanced": false,
      "desc": "BET fractional intensity threshold (0-1). Lower values give a larger brain estimate.",
      "default": 0.5
    },
    "robust": {
      "id": "robust",
      "type": "boolean",
      "placeholder": "",
      "advanced": false,
      "desc": "Use robust brain centre estimation (-R). Slower but more reliable for unusual head shapes.",
      "default": false
    },
    "bias_neck_cleanup": {
      "id": "bias_neck_cleanup",
      "type": "boolean",
      "placeholder": "",
      "advanced": false,
      "desc": "Bias-field + neck-cleanup pass (-B). Recommended when neck is included in the FOV.",
      "default": false
    }
  },
  "inputs": [
    {
      "id": "t1",
      "desc": "T1-weighted input volume to skull-strip",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "advanced": false
    }
  ],
  "outputs": [
    {
      "id": "t1_brain",
      "desc": "Skull-stripped T1w brain volume (FSL BET output)",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [
        "brain_extracted"
      ],
      "archive": true
    }
  ]
}
